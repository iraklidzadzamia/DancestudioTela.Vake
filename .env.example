# Public site origin used by canonical URLs, hreflang, structured data, robots,
# and the sitemap. Change this to https://tela-vake.ge only after registration.
VITE_SITE_ORIGIN=https://dancestudio-tela-vake.vercel.app

# Google measurement. Production defaults to the Tela GA4 stream below; this
# override is available for previews or a future migration to another stream.
VITE_GA_MEASUREMENT_ID=G-YZREYM9M7W

# Optional Google Ads destination. Import the GA4 key events instead of adding
# direct conversion labels for the same actions, so clicks are not counted twice.
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Public contact overrides. Production defaults live in src/contacts.ts.
VITE_INSTAGRAM_DM_URL=
VITE_FACEBOOK_MESSENGER_URL=
VITE_GOOGLE_MAPS_URL=
VITE_WHATSAPP_NUMBER=
VITE_PHONE_NUMBER=
