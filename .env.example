# Google measurement. Use GA4 as the primary source and link it to Google Ads.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: only set these when using a direct Google Ads website conversion.
# Do not also import the same GA4 event as a Primary conversion, or it may be counted twice.
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
VITE_GOOGLE_ADS_LEAD_LABEL=

# Public contact destinations. Vite embeds these at build time.
VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_PHONE_NUMBER=
