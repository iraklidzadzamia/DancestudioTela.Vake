{
  "name": "dancestudio-tela-vake",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && pnpm build:client && pnpm build:ssr && node scripts/prerender.mjs",
