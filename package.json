    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.0.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.11"
  }
}
