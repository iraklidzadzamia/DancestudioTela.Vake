{
  "rewrites": [
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/ka/:path*", "destination": "/index.html" },
    { "source": "/ru/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
